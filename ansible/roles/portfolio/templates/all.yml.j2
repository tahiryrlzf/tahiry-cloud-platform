---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: {{ ns_name }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ {'auths': {'ghcr.io': {'username': ghcr_username, 'password': ghcr_token, 'auth': (ghcr_username + ':' + ghcr_token) | b64encode}}} | to_json | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: {{ ns_name }}
type: Opaque
stringData:
  username: portfolio
  password: "CHANGE_ME_BOOTSTRAP_ONLY"
  url: "postgres://portfolio:CHANGE_ME_BOOTSTRAP_ONLY@portfolio-postgres:5432/portfolio?sslmode=disable"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: portfolio-frontend
  namespace: {{ ns_name }}
  labels:
    app.kubernetes.io/name: portfolio-frontend
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: portfolio-frontend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: portfolio-frontend
    spec:
      automountServiceAccountToken: false
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: frontend
          image: {{ frontend_image }}
          ports:
            - { name: http, containerPort: 8080 }
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests: { cpu: 30m, memory: 48Mi }
            limits: { cpu: 150m, memory: 96Mi }
          readinessProbe:
            httpGet: { path: /, port: http }
            initialDelaySeconds: 3
          volumeMounts:
            - { name: nginx-cache, mountPath: /var/cache/nginx }
            - { name: nginx-run, mountPath: /var/run }
            - { name: tmp, mountPath: /tmp }
      volumes:
        - { name: nginx-cache, emptyDir: {} }
        - { name: nginx-run, emptyDir: {} }
        - { name: tmp, emptyDir: { sizeLimit: 16Mi } }
---
apiVersion: v1
kind: Service
metadata:
  name: portfolio-frontend
  namespace: {{ ns_name }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: portfolio-frontend
  ports:
    - { name: http, port: 80, targetPort: http }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: portfolio-backend
  namespace: {{ ns_name }}
  labels:
    app.kubernetes.io/name: portfolio-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: portfolio-backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: portfolio-backend
    spec:
      automountServiceAccountToken: false
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: backend
          image: {{ backend_image }}
          ports:
            - { name: http, containerPort: 8080 }
          env:
            - { name: APP_ENV, value: "{{ ns_name }}" }
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: url
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests: { cpu: 30m, memory: 48Mi }
            limits: { cpu: 150m, memory: 128Mi }
          readinessProbe:
            httpGet: { path: /healthz, port: http }
            initialDelaySeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: portfolio-backend
  namespace: {{ ns_name }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: portfolio-backend
  ports:
    - { name: http, port: 80, targetPort: http }
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: portfolio
  namespace: {{ ns_name }}
spec:
  ingressClassName: traefik
  rules:
    - host: {{ ns_host }}
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: portfolio-backend
                port: { number: 80 }
          - path: /
            pathType: Prefix
            backend:
              service:
                name: portfolio-frontend
                port: { number: 80 }
