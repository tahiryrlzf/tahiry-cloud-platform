---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>
      <a href={`mailto:${site.links.email}?subject=Contact%20depuis%20tahiry-cloud.com`}>{site.links.email}</a>
      · © {year} {site.name}
    </span>
    <div class="footer-links">
      <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
      {site.links.linkedin && (
        <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      )}
      <a href={site.links.staging} target="_blank" rel="noopener">Staging</a>
    </div>
  </div>
</footer>
