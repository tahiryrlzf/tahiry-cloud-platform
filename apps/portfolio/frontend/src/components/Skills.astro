---
import { site } from "../data/site";
---

<section class="block container" id="skills">
  <p class="section-label">Compétences</p>
  <dl>
    {site.skills.map((s) => (
      <div class="skill-row">
        <dt>{s.domain}</dt>
        <dd>{s.items.join(" · ")}</dd>
      </div>
    ))}
  </dl>
</section>
