---
import { site } from "../data/site";

const statusLabel: Record<string, string> = {
  done: "Terminé",
  live: "En production",
  wip: "En cours",
  planned: "À venir",
};

const linkLabel: Record<string, string> = {
  done: "Voir le dépôt →",
  live: "Voir le dépôt →",
  wip: "Dépôt privé",
  planned: "À venir",
};
---

<section class="block container" id="projects">
  <p class="section-label">Projets</p>
  <div class="project-grid">
    {site.projects.map((p) => {
      const isLink = p.href && p.href.length > 0;
      const Tag = isLink ? "a" : "div";
      return (
        <Tag
          href={isLink ? p.href : undefined}
          class="project-card"
          target={isLink && p.href.startsWith("http") ? "_blank" : undefined}
          rel={isLink && p.href.startsWith("http") ? "noopener" : undefined}
        >
          <div class="project-head">
            <h3>{p.name}</h3>
            <span class={`status status-${p.status}`}>
              <span class="status-dot"></span>
              {statusLabel[p.status]}
            </span>
          </div>
          <p class="tagline">{p.tagline}</p>
          {p.context && <p class="project-context">{p.context}</p>}
          <p>{p.description}</p>
          <div class="tags">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <span class="project-link">
            {linkLabel[p.status]}
          </span>
        </Tag>
      );
    })}
  </div>
</section>
