---
import { site } from "../data/site";
---

<section class="block container" id="journal">
  <p class="section-label">Journal</p>
  <ul class="journal-list">
    {site.journal.map((entry) => (
      <li>
        {entry.published ? (
          <a href={`/journal/${entry.slug}`} class="journal-title">{entry.title}</a>
        ) : (
          <>
            <span class="journal-title journal-pending">{entry.title}</span>
            <span class="journal-badge">À venir</span>
          </>
        )}
      </li>
    ))}
  </ul>
</section>
